# Copy to .env for local development. Production values live in Coolify.
DATABASE_URL=postgres://enso:enso@127.0.0.1:55439/enso
# DATABASE_URL_ADMIN=            # owner role for migrations (optional; else DATABASE_URL)
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-characters
PUBLIC_URL=http://localhost:5173
# BETTER_AUTH_URL=              # defaults to PUBLIC_URL

# Mail (Stalwart). Unset in development: sign-in links are printed to the console.
# SMTP_URL=smtps://noreply%40enso.wicker.life:<password>@mail.wicker.life:465
# EMAIL_FROM=Ensō <noreply@enso.wicker.life>

# CI publishing (PUT /api/releases/:kind/:version)
RELEASE_TOKEN=dev-release-token
# EXTENSION_IDS=zen-chat@wicker.life     # comma separated; first is current

# Object storage (unset: bytes are stored in Postgres)
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRIVATE_BUCKET=wicker-01-private
# S3_PUBLIC_BUCKET=wicker-01-assets
# S3_PUBLIC_BASE_URL=https://wicker-01-assets.fsn1.your-objectstorage.com
# S3_PREFIX=enso

# Limits (defaults shown)
# SYNC_QUOTA_BYTES=1073741824
# SYNC_MAX_BLOB_BYTES=16777216
# SYNC_RATE_LIMIT_PER_MINUTE=300
# RELEASE_MAX_BYTES=209715200

# PUBLIC_UMAMI_WEBSITE_ID=
